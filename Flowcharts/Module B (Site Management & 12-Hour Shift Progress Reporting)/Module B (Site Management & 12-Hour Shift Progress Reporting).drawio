        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef startEnd fill:#cfd8dc,stroke:#37474f,stroke-width:2px;\n    classDef action fill:#bbdefb,stroke:#1976d2,stroke-width:2px;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef failure fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px;\n    classDef success fill:#c8e6c9,stroke:#388e3c,stroke-width:2px;\n\n    subgraph SiteCreation[\&quot;Site Creation &amp; Governance\&quot;]\n        S1([Site Leader Starts Site Creation]):::startEnd --&gt; D_Role{Has Authorized Site Leader Role?}:::decision\n        D_Role -- No --&gt; F_Role[Deny Site Creation Access]:::failure\n        D_Role -- Yes --&gt; S2[Select Site Center Method: Device GPS Position OR Interactive Map Pin]:::action\n        S2 --&gt; S3[Set Geofence Radius, Site Name &amp; Assign Authorized Workers]:::action\n        S3 --&gt; S4[Validate Data &amp; Activate Site]:::action\n        S4 --&gt; S5[Write Immutable Creation Entry to Audit Log with Actor ID &amp; Timestamp]:::action\n        S5 --&gt; S6([Site Active for Worker Attendance]):::startEnd\n\n        M1([Management Initiates Site Deactivation]):::startEnd --&gt; M2[Deactivate Site on Administrative Dashboard]:::action\n        M2 --&gt; M3[Write Deactivation Entry to Immutable Audit Log]:::action\n        M3 --&gt; M4([Site Deactivated: Rejects New Attendance Geofence Checks]):::startEnd\n    end\n\n    subgraph ShiftReporting[\&quot;12-Hour Shift Progress Reporting Flow\&quot;]\n        R1([Shift Reporting Window Opens Trigger]):::startEnd --&gt; R2[Notify Assigned Site Leader]:::action\n        R2 --&gt; R3[Site Leader Opens Structured 12-Hour Report Form]:::action\n        R3 --&gt; R4[Auto-Populate Shift ID, Site ID, Date, Cycle &amp; Verified Manpower Count]:::action\n        R4 --&gt; R5[Input Mandatory Fields: Work Completed Text &amp; Numeric Depth/Progress Metric]:::action\n        R5 --&gt; R6[Select Equipment Status &amp; Enter Explanatory Notes]:::action\n        R6 --&gt; R7[Indicate HSE/Incident Status &amp; Delay Causes]:::action\n        R7 --&gt; R8[Optionally Attach Progress Photos and/or Voice Note]:::action\n\n        R8 --&gt; D_Submit{Submit Before Window Closes?}:::decision\n\n        D_Submit -- No / Window Expired --&gt; Esc1[System Escalates Missed Report Event to Management]:::failure\n        Esc1 --&gt; Esc2[Flag Missed Reporting Window Anomaly on Web Dashboard]:::failure\n        Esc2 --&gt; Esc3([Reporting Window Closed - Missed]):::startEnd\n\n        D_Submit -- Yes --&gt; D_Val{All Required Fields Present &amp; Valid?}:::decision\n        D_Val -- No --&gt; F_Val[Block Submission &amp; Highlight Missing Required Fields]:::failure\n        F_Val --&gt; R5\n\n        D_Val -- Yes --&gt; R9[Timestamp &amp; Bind Report to Submitting Site Leader ID]:::action\n        R9 --&gt; R10[Save Report to Local Device Queue]:::action\n        R10 --&gt; D_Inc{HSE Incident or Equipment Failure Reported?}:::decision\n\n        D_Inc -- Yes --&gt; Flag_R[Surface Report for Immediate Administrative Attention Priority]:::failure\n        D_Inc -- No --&gt; Standard_R[Queue Report for Standard Background Synchronization]:::success\n\n        Flag_R --&gt; R11([Report Submitted &amp; Locally Queued]):::startEnd\n        Standard_R --&gt; R11\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y70Dy5G0FGm0f80i77p7-66">

        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef startEnd fill:#cfd8dc,stroke:#37474f,stroke-width:2px;\n    classDef action fill:#bbdefb,stroke:#1976d2,stroke-width:2px;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef failure fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px;\n    classDef success fill:#c8e6c9,stroke:#388e3c,stroke-width:2px;\n\n    subgraph Enrollment[\&quot;Worker Biometric Enrollment (One-Time)\&quot;]\n        E1([Start Enrollment]):::startEnd --&gt; E2[Capture Facial Samples under Varying Conditions]:::action\n        E2 --&gt; E3[Generate Numerical Face Embedding on Device]:::action\n        E3 --&gt; E4[Link Face Embedding to Worker Identifier]:::action\n        E4 --&gt; E5[Discard Raw Facial Enrollment Photographs]:::action\n        E5 --&gt; E6([Enrollment Complete]):::startEnd\n    end\n\n    subgraph Attendance[\&quot;Attendance Check-In / Check-Out Verification Flow\&quot;]\n        A1([Worker Initiates Attendance Event]):::startEnd --&gt; A2[Obtain Device GPS Location &amp; Target Site Assignment]:::action\n        A2 --&gt; D1{Inside Assigned Active Site Geofence?}:::decision\n\n        D1 -- No --&gt; F1[Reject: Worker Outside Geofence]:::failure\n        D1 -- Yes --&gt; D2{OS Mock-Location Provider Detected?}:::decision\n\n        D2 -- Yes --&gt; F2[Reject: Flag Event as Suspicious Fraud]:::failure\n        D2 -- No --&gt; A3[Prompt Worker for Active Liveness Challenge]:::action\n\n        A3 --&gt; D3{Liveness Action Passed?}:::decision\n        D3 -- No --&gt; F3[Reject: Liveness Challenge Failed]:::failure\n\n        D3 -- Yes --&gt; A4[Capture Live Face &amp; Generate Live Embedding]:::action\n        A4 --&gt; A5[Compare Live Embedding with Enrolled Reference Embedding]:::action\n        A5 --&gt; D4{Similarity Score &gt;= Threshold?}:::decision\n\n        D4 -- No --&gt; F4[Reject: Face Match Failed]:::failure\n        D4 -- Yes --&gt; A6[Accept Verified Attendance Event]:::success\n\n        A6 --&gt; D5{Event Type?}:::decision\n        D5 -- Check-In --&gt; A7[Record Verified Check-In with GPS, Timestamp, Site ID &amp; Verification Context]:::action\n        D5 -- Check-Out --&gt; A8[Record Verified Check-Out &amp; Link to Previous Verified Check-In]:::action\n\n        A8 --&gt; A9[Calculate Measured Interval Worked Hours]:::action\n        A9 --&gt; A10[Derive Overtime against Configured Site Shift Schedule]:::action\n\n        A7 --&gt; A11[Write Complete Record to Local Device Storage Immediately]:::action\n        A10 --&gt; A11\n        A11 --&gt; A12[Queue Event for Automatic Synchronization Engine]:::action\n        A12 --&gt; A13([Attendance Flow Complete]):::startEnd\n\n        F1 --&gt; F5[Display Failure Category Message to Worker]:::failure\n        F2 --&gt; F5\n        F3 --&gt; F5\n        F4 --&gt; F5\n        F5 --&gt; A14([Event Terminated - No Verified Event Constructed]):::startEnd\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y70Dy5G0FGm0f80i77p7-1">

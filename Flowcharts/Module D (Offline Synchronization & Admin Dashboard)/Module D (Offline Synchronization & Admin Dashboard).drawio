        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef startEnd fill:#cfd8dc,stroke:#37474f,stroke-width:2px;\n    classDef action fill:#bbdefb,stroke:#1976d2,stroke-width:2px;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef failure fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px;\n    classDef success fill:#c8e6c9,stroke:#388e3c,stroke-width:2px;\n\n    subgraph OfflineSync[\&quot;Offline Capture &amp; Local Queue Engine\&quot;]\n        S1([Field Event Captured Offline]):::startEnd --&gt; S2[Persist Complete Record to Local Storage Immediately]:::action\n        S2 --&gt; S3[Assign Unique Stable Event Identifier]:::action\n        S3 --&gt; S4[Add Record &amp; Media Attachments to Local Synchronization Queue]:::action\n        S4 --&gt; S5[Expose &#39;Pending Sync&#39; Status on Mobile App UI]:::action\n\n        S5 --&gt; D_Net{Network Connectivity Available?}:::decision\n        D_Net -- No --&gt; S6[Retain Record in Queue; Continue Field Operations Offline]:::action\n        S6 --&gt; D_Net\n\n        D_Net -- Yes --&gt; S7[Initiate Auto-Sync Transmission to Backend API]:::action\n        S7 --&gt; S8[Server Validates Record Integrity, Signatures &amp; Idempotent Event ID]:::action\n\n        S8 --&gt; D_Valid{Server Validation Passed?}:::decision\n\n        D_Valid -- Duplicate / Retransmission --&gt; S9[Acknowledge Request; Ignore Duplicate Storage]:::success\n        D_Valid -- Rejected / Failed --&gt; F_Sync[Mark Local Queue Item as Failed; Retain for Resolution]:::failure\n\n        D_Valid -- Yes / New Record --&gt; S10[Persist Record in Central Relational DB &amp; Media in Object Storage]:::success\n        S10 --&gt; S11[Update Mobile Queue Status to &#39;Synchronized&#39;]:::success\n        S9 --&gt; S11\n        S11 --&gt; S12([Local Synchronization Complete]):::startEnd\n    end\n\n    subgraph AdminDashboard[\&quot;Administrative Dashboard Oversight &amp; Anomaly Management\&quot;]\n        D_Start([User Opens Web Dashboard]):::startEnd --&gt; D_View{Select Dashboard View}:::decision\n\n        D_View -- Attendance --&gt; V1[View Live Synchronized Attendance &amp; Calculated Worked Hours]:::action\n        D_View -- Reports --&gt; V2[Access Chronological Site Progress Report Archive]:::action\n        D_View -- Fleet --&gt; V3[View Live Map Position of Open Sessions, Route History &amp; Condition Log]:::action\n        D_View -- Audit Trail --&gt; V4[Review Immutable Audit Trail for Site Creation &amp; Modifications]:::action\n\n        D_View -- Flagged Events Queue --&gt; V5[Inspect System Flagged Anomalies]:::action\n\n        V5 --&gt; D_FlagType{Flagged Anomaly Category?}:::decision\n\n        D_FlagType -- Mock Location --&gt; F_A1[Review Mock-Location Detection Context &amp; GPS Data]:::failure\n        D_FlagType -- Failed Liveness --&gt; F_A2[Review Failed Liveness Verification Attempts]:::failure\n        D_FlagType -- Missed Shift Report --&gt; F_A3[Review Escalated Missed 12-Hour Shift Report Alert]:::failure\n        D_FlagType -- Incident / HSE --&gt; F_A4[Review Incident / Equipment Failure Notes &amp; Attachments]:::failure\n        D_FlagType -- Vehicle Fault --&gt; F_A5[Review Vehicle Fault Alert &amp; Inspection Evidence]:::failure\n\n        F_A1 --&gt; AdmAct[Take Administrative Action e.g., Deactivate Site, Resolve Dispute, Dispatch Maintenance]:::action\n        F_A2 --&gt; AdmAct\n        F_A3 --&gt; AdmAct\n        F_A4 --&gt; AdmAct\n        F_A5 --&gt; AdmAct\n\n        V1 --&gt; D_End([Dashboard Oversight Complete]):::startEnd\n        V2 --&gt; D_End\n        V3 --&gt; D_End\n        V4 --&gt; D_End\n        AdmAct --&gt; D_End\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y70Dy5G0FGm0f80i77p7-211">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

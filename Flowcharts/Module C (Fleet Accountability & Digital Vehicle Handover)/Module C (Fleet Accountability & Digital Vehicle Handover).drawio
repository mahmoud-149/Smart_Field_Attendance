        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef startEnd fill:#cfd8dc,stroke:#37474f,stroke-width:2px;\n    classDef action fill:#bbdefb,stroke:#1976d2,stroke-width:2px;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef failure fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px;\n    classDef success fill:#c8e6c9,stroke:#388e3c,stroke-width:2px;\n\n    subgraph VehicleClaim[\&quot;Phase 1: Vehicle Claim\&quot;]\n        C1([Driver Scans Vehicle QR Code]):::startEnd --&gt; C2[Resolve Vehicle Identifier from QR Code Data]:::action\n        C2 --&gt; D_Claim{Vehicle Currently Available?}:::decision\n        D_Claim -- No / Active Session Exists --&gt; F_Claim[Reject Claim: Vehicle Already in Use]:::failure\n        F_Claim --&gt; C_End1([Claim Terminated]):::startEnd\n\n        D_Claim -- Yes --&gt; C3[Create Vehicle Session: Driver ID, Vehicle ID, Start Timestamp]:::action\n        C3 --&gt; C4[Update Vehicle Status to &#39;In Use&#39;]:::action\n        C4 --&gt; C5([Custody Session Opened - Trip Start Gated]):::startEnd\n    end\n\n    subgraph PreTrip[\&quot;Phase 2: Mandatory Pre-Trip Inspection Gating\&quot;]\n        P1([Initiate Pre-Trip Inspection]):::startEnd --&gt; P2[Capture 4 Exterior Photos: Front, Rear, Left, Right]:::action\n        P2 --&gt; P3[Capture Dashboard Photo: Odometer &amp; Fuel Level]:::action\n        P3 --&gt; P4[Bind Evidence to Vehicle ID, GPS Position &amp; Timestamp]:::action\n        P4 --&gt; D_Warn{Active Warning Lights or Visible Pre-Existing Damage?}:::decision\n\n        D_Warn -- Yes --&gt; P5[Require Mandatory Text Description or Voice Note]:::action\n        D_Warn -- No --&gt; P6[Confirm Pre-Trip Inspection Answers]:::action\n        P5 --&gt; P6\n\n        P6 --&gt; D_Gate{All Mandatory Photos &amp; Explanations Present?}:::decision\n        D_Gate -- No --&gt; F_Gate[Keep Trip Start Disabled]:::failure\n        F_Gate --&gt; P1\n\n        D_Gate -- Yes --&gt; P7[Enable Trip Start Action]:::success\n        P7 --&gt; P8([Trip Ready to Begin]):::startEnd\n    end\n\n    subgraph ActiveTrip[\&quot;Phase 3: Operational Trip &amp; Route Tracking\&quot;]\n        T1([Driver Starts Trip]):::startEnd --&gt; T2[Begin Active Route Tracking under Open Custody Session]:::action\n        T2 --&gt; T3[Record Operational Route Coordinates &amp; Distance]:::action\n        T3 --&gt; T4[Buffer Route Points Locally if Network Offline]:::action\n        T4 --&gt; T5([Vehicle Arrives at Destination]):::startEnd\n    end\n\n    subgraph PostTrip[\&quot;Phase 4: Post-Trip Inspection, Fault Escalation &amp; Release\&quot;]\n        E1([Driver Initiates Vehicle Release]):::startEnd --&gt; E2[Capture Mandatory Final Odometer Photo]:::action\n        E2 --&gt; E3[Calculate Custody Distance Driven from Odometer Readings]:::action\n        E3 --&gt; D_Fault{Mechanical Issues, Unusual Noises, or Accidents Occurred?}:::decision\n\n        D_Fault -- Yes --&gt; E4[Require Mandatory Text Description or Voice Note]:::action\n        E4 --&gt; E5[Raise Maintenance Fault Alert on Dashboard]:::failure\n        E5 --&gt; E6[Bind Post-Trip Evidence to Session]:::action\n\n        D_Fault -- No --&gt; E6\n        E6 --&gt; D_Release{Post-Trip Inspection Requirements Complete?}:::decision\n\n        D_Release -- No --&gt; F_Rel[Block Vehicle Release Action]:::failure\n        F_Rel --&gt; E1\n\n        D_Release -- Yes --&gt; E7[Stop Route Tracking &amp; Close Vehicle Session]:::action\n        E7 --&gt; E8[Store Summary: Origin, Route, Destination, Total Distance &amp; Duration]:::action\n        E8 --&gt; E9[Update Vehicle Status back to &#39;Available&#39;]:::success\n        E9 --&gt; E10([Vehicle Custody Released]):::startEnd\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y70Dy5G0FGm0f80i77p7-132">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
